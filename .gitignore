# Ignore everything #
#**

# Add two rules for each Theme or Plugin you want to include:
# 1. !folder-name/    <-- includes the Plugin and top level files
# 2. !folder-name/**  <-- includes the Plugin and sub level files recursively, except for the "Ignore some other system generated files" rules below
###############################

# Start editing!

# Assets
!assets/
!assets/**

# Stop editing!

############################################
# Ignore some other system generated files #
############################################
*.com
*.class
*.dll
*.exe
*.o
*.so
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.log
*.sql
*.sqlite
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.codekit-cache
.sass-cache
# Sublime
*.sublime-project
*.sublime-workspace
# PhpStorm
.idea/

# Always include the build script #
###################################
!build.sh
!README.md
!CHANGELOG.md
!.gitignore

# Supabase schema is source, not a database dump — the *.sql rule above
# would otherwise exclude it
!supabase/schema/*.sql

# Deno pulls these in when typechecking the Edge Function locally
supabase/functions/**/node_modules/
supabase/functions/**/deno.lock

*node_modules/*

# Environment variables
.env
creds.txt
creds.md
