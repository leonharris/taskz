{
  "name": "taskz",
  "version": "1.0.0",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/main.css --style compressed",
    "build:js": "node build.js",
    "build": "npm-run-all build:css build:js",
    "watch:css": "sass assets/scss/main.scss assets/css/main.css --watch",
    "watch:js": "node build.js --watch",
    "watch": "npm-run-all --parallel watch:css watch:js",
    "serve": "serve -l 3001",
    "dev": "npm-run-all --parallel watch serve"
  },
  "dependencies": {
    "@jaames/iro": "^5.5.2",
    "@supabase/supabase-js": "^2.93.3",
    "sortablejs": "^1.15.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.3",
    "serve": "^14.2.5"
  }
}
